# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — only needed if you want public profile pages (/u/<username>)
# Same Settings → API page, under "Project API keys", labeled `service_role` `secret`
# KEEP THIS SECRET — never expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# App URL (use localhost in dev, your vercel domain in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL — Resend (newsletter sending). Free tier = 100 emails/day, 3000/month
# Sign up at https://resend.com — without this, the Newsletter Studio still works
# but the "Send now" button shows a 503 with setup docs.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Your Name <you@yourdomain.com>"

# OPTIONAL — Override the AI model and rate limits if needed
# ANTHROPIC_MODEL=claude-sonnet-4-5
# AI_RATE_LIMIT_PER_HOUR=30
# AI_RATE_LIMIT_PER_DAY=150
